generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String?
  email        String        @unique
  password     String
  scholarships Scholarship[]
  createdAt    DateTime      @default(now())
}

model Scholarship {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  provider  String?
  url       String?
  deadline  String?
  status    String   @default("Pending")
  documents String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
